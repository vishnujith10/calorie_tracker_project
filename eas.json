{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "env": {
          "EXPO_USE_LEGACY_ANDROIDX": "false"
        }
      }
    }
  },
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote"
  }
}